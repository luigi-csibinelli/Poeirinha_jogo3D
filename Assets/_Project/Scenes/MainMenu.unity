  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Voc\xEA \xE9 um <color=#5CE0B8><b>rob\xF4 aspirador</b></color>. Aspire
    <b>90%</b> da sujeira antes do dono voltar (3 minutos).\n\n<b>W / S</b> ou setas:
    andar para frente / r\xE9\n<b>A / D</b> ou setas: girar  |  <b>Mouse</b>: olhar
    em volta (roda = zoom)\n<b>Shift</b> (segurar): turbo - mais r\xE1pido, gasta
    o dobro de bateria\n<b>E</b> (v\xE1rias vezes): soltar-se de uma meia enroscada\n<b>Esc</b>:
    pausar\n\n<color=#FFD24D>Bateria:</color> volte \xE0 <b>base azul</b> para recarregar.\n<color=#FF6B5E>Cuidado:</color>
    a escada n\xE3o tem grade - se cair, acabou! O bip avisa quando a borda est\xE1
    perto.\nO <b>gato</b> corre atr\xE1s do rob\xF4 quando te v\xEA: fuja no turbo
    ou <b>esconda-se embaixo do sof\xE1 ou da cama</b>!\nTem sujeira escondida embaixo
    dos m\xF3veis. Sensibilidade e volume em <b>Op\xE7\xF5es</b>."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
